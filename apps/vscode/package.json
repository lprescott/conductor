{
  "name": "conductor-vscode",
  "displayName": "Conductor",
  "description": "Live Strudel coding from VS Code — AI-ready MCP bridge",
  "version": "0.2.5",
  "publisher": "lprescott",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/lprescott/conductor.git"
  },
  "bugs": {
    "url": "https://github.com/lprescott/conductor/issues"
  },
  "homepage": "https://github.com/lprescott/conductor#readme",
  "sponsor": { "url": "https://buymeacoffee.com/lprescott" },
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other", "Notebooks"],
  "keywords": ["strudel", "live coding", "music", "mcp", "ai", "algorave"],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "conductor.play",           "title": "Conductor: Play",                    "icon": "$(play)" },
      { "command": "conductor.stop",           "title": "Conductor: Stop",                    "icon": "$(debug-stop)" },
      { "command": "conductor.togglePlay",     "title": "Conductor: Toggle Play/Stop" },
      { "command": "conductor.newSong",        "title": "Conductor: New Song",                "icon": "$(add)" },
      { "command": "conductor.startDaemon",    "title": "Conductor: Start Daemon" },
      { "command": "conductor.savePattern",    "title": "Conductor: Save Pattern",            "icon": "$(save)" },
      { "command": "conductor.loadPattern",    "title": "Conductor: Load Pattern..." },
      { "command": "conductor.deletePattern",  "title": "Conductor: Delete Pattern",          "icon": "$(trash)" },
      { "command": "conductor.refreshPatterns","title": "Conductor: Refresh Patterns",        "icon": "$(refresh)" },
      { "command": "conductor.insertPatternSnippet", "title": "Conductor: Insert Pattern Snippet", "icon": "$(insert)" },
      { "command": "conductor.initMcp",        "title": "Conductor: Add .mcp.json to Workspace" }
    ],
    "views": {
      "explorer": [
        {
          "id": "conductorPatterns",
          "name": "Conductor Patterns"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "conductor.strudelEditor",
        "displayName": "Conductor",
        "selector": [{ "filenamePattern": "*.strudel" }],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "javascript",
        "extensions": [".strudel"]
      }
    ],
    "menus": {
      "view/title": [
        { "command": "conductor.newSong",         "when": "view == conductorPatterns", "group": "navigation" },
        { "command": "conductor.refreshPatterns", "when": "view == conductorPatterns", "group": "navigation" },
        { "command": "conductor.savePattern",     "when": "view == conductorPatterns", "group": "navigation" }
      ],
      "view/item/context": [
        { "command": "conductor.deletePattern", "when": "view == conductorPatterns && viewItem == pattern", "group": "inline" }
      ]
    },
    "keybindings": [
      {
        "command": "conductor.togglePlay",
        "key": "ctrl+shift+space",
        "mac": "cmd+shift+space"
      }
    ],
    "configuration": {
      "title": "Conductor",
      "properties": {
        "conductor.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:7777",
          "description": "Probe this URL first; if it answers /health, adopt it instead of spawning a daemon. Useful for pointing at a remote or pre-started instance."
        }
      }
    }
  },
  "activationEvents": [
    "onCustomEditor:conductor.strudelEditor",
    "workspaceContains:**/*.strudel",
    "workspaceContains:patterns/*.js",
    "onCommand:conductor.startDaemon",
    "onCommand:conductor.newSong",
    "onCommand:conductor.initMcp",
    "onView:conductorPatterns"
  ],
  "scripts": {
    "copy-strudel": "node -e \"require('fs').cpSync(require.resolve('@strudel/repl/dist/index.js'),'media/strudel.js')\"",
    "copy-license": "node -e \"require('fs').cpSync('../../LICENSE','LICENSE')\"",
    "copy-daemon": "node -e \"require('fs').cpSync('../../server/dist/daemon.cjs','media/daemon.cjs')\"",
    "prebuild": "pnpm copy-strudel && pnpm copy-license && node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "prepackage": "pnpm --filter server bundle && pnpm copy-daemon",
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "dev": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --watch",
    "pretest": "pnpm copy-strudel",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "pnpm build && vsce package --no-dependencies"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@strudel/repl": "1.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.5.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "~5.7.3",
    "vitest": "^3.1.4"
  }
}
